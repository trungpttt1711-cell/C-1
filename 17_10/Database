
CREATE DATABASE IF NOT EXISTS QuanLySinhVienDB
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;

USE QuanLySinhVienDB;

CREATE TABLE IF NOT EXISTS LopHoc (
    MaLop VARCHAR(7) NOT NULL,
    TenLop VARCHAR(100) NOT NULL,
    PRIMARY KEY (MaLop)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS SinhVien (
    MaSV VARCHAR(8) NOT NULL,
    HoTen VARCHAR(100) NOT NULL,
    MaLop VARCHAR(7) NOT NULL,
    NgaySinh DATE NOT NULL,
    GioiTinh VARCHAR(10),
    DiaChi VARCHAR(255),
    SoDienThoai VARCHAR(15),
    Email VARCHAR(100),
    TrangThai VARCHAR(50),
    Diem DOUBLE NOT NULL DEFAULT 0,
    PRIMARY KEY (MaSV),
    INDEX IX_SinhVien_MaLop (MaLop),
    CONSTRAINT FK_SinhVien_LopHoc
        FOREIGN KEY (MaLop)
        REFERENCES LopHoc(MaLop)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
) ENGINE=InnoDB;

SET @hasDiaChi = (
    SELECT COUNT(*)
    FROM information_schema.COLUMNS
    WHERE TABLE_SCHEMA = DATABASE()
      AND TABLE_NAME = 'SinhVien'
      AND COLUMN_NAME = 'DiaChi'
);

SET @sql = IF(
    @hasDiaChi = 0,
    'ALTER TABLE SinhVien ADD COLUMN DiaChi VARCHAR(255) NULL',
    'SELECT 1'
);

PREPARE stmt FROM @sql;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;

