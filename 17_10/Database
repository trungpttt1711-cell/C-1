
CREATE DATABASE IF NOT EXISTS QuanLySinhVienMoi
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;

USE QuanLySinhVienMoi;

CREATE TABLE IF NOT EXISTS LopHoc (
    MaLop VARCHAR(7) NOT NULL,
    TenLop VARCHAR(100) NOT NULL,
    PRIMARY KEY (MaLop),
    CONSTRAINT CK_LopHoc_MaLop
        CHECK (MaLop REGEXP '^CSE[0-9]{4}$')
);

CREATE TABLE IF NOT EXISTS SinhVien (
    MaSV VARCHAR(8) NOT NULL,
    HoTen VARCHAR(100) NOT NULL,
    NgaySinh DATE NOT NULL,
    GioiTinh VARCHAR(3) NOT NULL,
    Email VARCHAR(254) NOT NULL,
    DienThoai VARCHAR(10) NOT NULL,
    Diem DECIMAL(4,2) NOT NULL DEFAULT 0,
    MaLop VARCHAR(7) NOT NULL,
    TrangThai VARCHAR(30) NOT NULL DEFAULT 'Đang học',

    PRIMARY KEY (MaSV),

    CONSTRAINT FK_SinhVien_LopHoc
        FOREIGN KEY (MaLop)
        REFERENCES LopHoc(MaLop),

    CONSTRAINT CK_SinhVien_Diem
        CHECK (Diem BETWEEN 0 AND 10),

    CONSTRAINT CK_SinhVien_MaSV
        CHECK (MaSV REGEXP '^SV[0-9]{6}$'),

    CONSTRAINT CK_SinhVien_GioiTinh
        CHECK (GioiTinh IN ('Nam', 'Nữ'))
);

