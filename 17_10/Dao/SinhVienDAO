
using System;
using System.Collections.Generic;
using MySql.Data.MySqlClient;
using QuanLySinhVien.DTO;

namespace QuanLySinhVien.DAL
{
    public class SinhVienDAO
    {
        private SinhVien ChuyenThanhSinhVien(MySqlDataReader reader)
        {
            SinhVien sv = new SinhVien
            {
                MaSV = reader["MaSV"].ToString() ?? "",
                HoTen = reader["HoTen"].ToString() ?? "",
                NgaySinh = Convert.ToDateTime(reader["NgaySinh"]),
                GioiTinh = reader["GioiTinh"].ToString() ?? "",
                Email = reader["Email"].ToString() ?? "",
                DienThoai = reader["DienThoai"].ToString() ?? "",
                Diem = Convert.ToDecimal(reader["Diem"]),
                MaLop = reader["MaLop"].ToString() ?? "",
                TrangThai = reader["TrangThai"].ToString() ?? ""
            };

            sv.LopHoc = new LopHoc
            {
                MaLop = sv.MaLop,
                TenLop = reader["TenLop"].ToString() ?? ""
            };

            return sv;
        }

        public List<SinhVien> LayDanhSach()
        {
            List<SinhVien> danhSach = new List<SinhVien>();

            string sql = @"
                SELECT sv.*, lh.TenLop
                FROM SinhVien sv
                INNER JOIN LopHoc lh
                    ON sv.MaLop = lh.MaLop
                ORDER BY sv.MaSV";

            using (MySqlConnection conn = DataHelper.GetConnection())
            using (MySqlCommand cmd = new MySqlCommand(sql, conn))
            {
                conn.Open();

                using (MySqlDataReader reader = cmd.ExecuteReader())
                {
                    while (reader.Read())
                    {
                        danhSach.Add(ChuyenThanhSinhVien(reader));
                    }
                }
            }

            return danhSach;
        }

        public SinhVien? TimTheoMa(string maSV)
        {
            string sql = @"
                SELECT sv.*, lh.TenLop
                FROM SinhVien sv
                INNER JOIN LopHoc lh
                    ON sv.MaLop = lh.MaLop
                WHERE sv.MaSV = @MaSV";

            using (MySqlConnection conn = DataHelper.GetConnection())
            using (MySqlCommand cmd = new MySqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("@MaSV", maSV);

                conn.Open();

                using (MySqlDataReader reader = cmd.ExecuteReader())
                {
                    if (reader.Read())
                    {
                        return ChuyenThanhSinhVien(reader);
                    }
                }
            }

            return null;
        }

        public bool KiemTraTonTai(string maSV)
        {
            string sql = @"
                SELECT COUNT(*)
                FROM SinhVien
                WHERE MaSV = @MaSV";

            using (MySqlConnection conn = DataHelper.GetConnection())
            using (MySqlCommand cmd = new MySqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("@MaSV", maSV);

                conn.Open();

                return Convert.ToInt32(cmd.ExecuteScalar()) > 0;
            }
        }

        public bool Them(SinhVien sv)
        {
            string sql = @"
                INSERT INTO SinhVien
                (MaSV, HoTen, NgaySinh, GioiTinh,
                 Email, DienThoai, Diem, MaLop, TrangThai)
                VALUES
                (@MaSV, @HoTen, @NgaySinh, @GioiTinh,
                 @Email, @DienThoai, @Diem, @MaLop, @TrangThai)";

            using (MySqlConnection conn = DataHelper.GetConnection())
            using (MySqlCommand cmd = new MySqlCommand(sql, conn))
            {
                ThemThamSo(cmd, sv);

                conn.Open();

                return cmd.ExecuteNonQuery() > 0;
            }
        }

        public bool Sua(SinhVien sv)
        {
            string sql = @"
                UPDATE SinhVien
                SET HoTen = @HoTen,
                    NgaySinh = @NgaySinh,
                    GioiTinh = @GioiTinh,
                    Email = @Email,
                    DienThoai = @DienThoai,
                    Diem = @Diem,
                    MaLop = @MaLop,
                    TrangThai = @TrangThai
                WHERE MaSV = @MaSV";

            using (MySqlConnection conn = DataHelper.GetConnection())
            using (MySqlCommand cmd = new MySqlCommand(sql, conn))
            {
                ThemThamSo(cmd, sv);

                conn.Open();

                return cmd.ExecuteNonQuery() > 0;
            }
        }

        public bool Xoa(string maSV)
        {
            string sql = @"
                DELETE FROM SinhVien
                WHERE MaSV = @MaSV";

            using (MySqlConnection conn = DataHelper.GetConnection())
            using (MySqlCommand cmd = new MySqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("@MaSV", maSV);

                conn.Open();

                return cmd.ExecuteNonQuery() > 0;
            }
        }

        public List<SinhVien> TimKiem(
            string tuKhoa,
            string maLop,
            decimal diemTu)
        {
            List<SinhVien> danhSach = new List<SinhVien>();

            string sql = @"
                SELECT sv.*, lh.TenLop
                FROM SinhVien sv
                INNER JOIN LopHoc lh
                    ON sv.MaLop = lh.MaLop
                WHERE
                    (
                        @TuKhoa = ''
                        OR sv.MaSV LIKE @Pattern
                        OR sv.HoTen LIKE @Pattern
                        OR sv.Email LIKE @Pattern
                        OR sv.DienThoai LIKE @Pattern
                    )
                    AND (@MaLop = '' OR sv.MaLop = @MaLop)
                    AND sv.Diem >= @DiemTu
                ORDER BY sv.MaSV";

            tuKhoa = (tuKhoa ?? "").Trim();
            maLop = (maLop ?? "").Trim();

            string pattern = "%" +
                tuKhoa.Replace("\\", "\\\\")
                      .Replace("%", "\\%")
                      .Replace("_", "\\_") +
                "%";

            using (MySqlConnection conn = DataHelper.GetConnection())
            using (MySqlCommand cmd = new MySqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("@TuKhoa", tuKhoa);
                cmd.Parameters.AddWithValue("@Pattern", pattern);
                cmd.Parameters.AddWithValue("@MaLop", maLop);
                cmd.Parameters.AddWithValue("@DiemTu", diemTu);

                conn.Open();

                using (MySqlDataReader reader = cmd.ExecuteReader())
                {
                    while (reader.Read())
                    {
                        danhSach.Add(ChuyenThanhSinhVien(reader));
                    }
                }
            }

            return danhSach;
        }

        private void ThemThamSo(MySqlCommand cmd, SinhVien sv)
        {
            cmd.Parameters.AddWithValue("@MaSV", sv.MaSV);
            cmd.Parameters.AddWithValue("@HoTen", sv.HoTen);
            cmd.Parameters.AddWithValue("@NgaySinh", sv.NgaySinh.Date);
            cmd.Parameters.AddWithValue("@GioiTinh", sv.GioiTinh);
            cmd.Parameters.AddWithValue("@Email", sv.Email);
            cmd.Parameters.AddWithValue("@DienThoai", sv.DienThoai);
            cmd.Parameters.AddWithValue("@Diem", sv.Diem);
            cmd.Parameters.AddWithValue("@MaLop", sv.MaLop);
            cmd.Parameters.AddWithValue("@TrangThai", sv.TrangThai);
        }
    }
}
